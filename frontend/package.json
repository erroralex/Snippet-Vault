{
  "name": "snippet-vault",
  "version": "1.0.0",
  "description": "A local-first desktop code snippet manager with Monaco Editor, Spring Boot backend, and real-time sync.",
  "main": "electron/main.js",
  "author": "Alexander Nilsson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erroralex/Snippet-Vault.git"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "electron:dev": "wait-on http://localhost:4200 && electron .",
    "dev": "concurrently \"npm run start\" \"npm run electron:dev\"",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.nilsson.snippet-vault",
    "productName": "Snippet Vault",
    "copyright": "Copyright © 2025 Alexander Nilsson",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/frontend/browser/**/*",
      "electron/**/*",
      "splash.html",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons/icon.ico"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "public/icons",
      "category": "Development"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "public/icons/icon.icns",
      "category": "public.app-category.developer-tools"
    }
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/platform-server": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@stomp/stompjs": "^7.3.0",
    "express": "^5.1.0",
    "monaco-editor": "^0.55.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.7",
    "@angular/cli": "^21.2.7",
    "@angular/compiler-cli": "^21.2.0",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.5"
  }
}
